<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/v2_pill_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_kinex_dock_bar"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="10dp"
    android:paddingTop="4dp"
    android:paddingEnd="10dp"
    android:paddingBottom="4dp"
    android:elevation="8dp">

    <!-- จุดจับลาก (Drag Handle) -->
    <TextView
        android:id="@+id/tv_drag_handle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⋮⋮"
        android:textColor="#546E7A"
        android:textSize="12sp"
        android:paddingEnd="6dp" />

    <!-- 1. ระดับแบตเตอรี่ปัจจุบัน (Current SoC) -->
    <LinearLayout
        android:id="@+id/container_v2_soc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚡"
            android:textSize="11sp"
            android:paddingEnd="2dp" />

        <TextView
            android:id="@+id/tv_v2_soc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--%"
            android:textColor="#69F0AE"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:id="@+id/divider_v2_1"
        android:layout_width="1dp"
        android:layout_height="11dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        android:background="#26FFFFFF" />

    <!-- 2. พลังงานแบตเตอรี่คงเหลือจริง (Remaining kWh จาก BMS) -->
    <LinearLayout
        android:id="@+id/container_v2_kwh"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔋"
            android:textSize="11sp"
            android:paddingEnd="2dp" />

        <TextView
            android:id="@+id/tv_v2_kwh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-- kWh"
            android:textColor="#00E676"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:id="@+id/divider_v2_2"
        android:layout_width="1dp"
        android:layout_height="11dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        android:background="#26FFFFFF" />

    <!-- 3. ระยะทางวิ่งได้จริง (Real Range) -->
    <LinearLayout
        android:id="@+id/container_v2_real_range"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🚗"
            android:textSize="11sp"
            android:paddingEnd="2dp" />

        <TextView
            android:id="@+id/tv_v2_real_range"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-- km"
            android:textColor="#40C4FF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:id="@+id/divider_v2_dash_range"
        android:layout_width="1dp"
        android:layout_height="11dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        android:background="#26FFFFFF"
        android:visibility="gone" />

    <!-- 3B. ระยะทางบนหน้าปัดรถ (Dashboard Range) -->
    <LinearLayout
        android:id="@+id/container_v2_dash_range"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📟"
            android:textSize="11sp"
            android:paddingEnd="2dp" />

        <TextView
            android:id="@+id/tv_v2_dash_range"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-- km"
            android:textColor="#80D8FF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:id="@+id/divider_v2_hv_temp"
        android:layout_width="1dp"
        android:layout_height="11dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        android:background="#26FFFFFF" />

    <!-- 3C. อุณหภูมิแบตเตอรี่ลูกใหญ่ (HV Main Battery Temp) -->
    <LinearLayout
        android:id="@+id/container_v2_hv_temp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🌡️แบต"
            android:textColor="#FFAB40"
            android:textSize="10sp"
            android:paddingEnd="2dp" />

        <TextView
            android:id="@+id/tv_v2_hv_temp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="29°C"
            android:textColor="#FFAB40"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:id="@+id/divider_v2_cell_volt"
        android:layout_width="1dp"
        android:layout_height="11dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        android:background="#26FFFFFF"
        android:visibility="gone" />

    <!-- 3D. แรงดันเซลล์แบตใหญ่ (HV Cell Voltage) -->
    <LinearLayout
        android:id="@+id/container_v2_cell_volt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔬"
            android:textSize="11sp"
            android:paddingEnd="2dp" />

        <TextView
            android:id="@+id/tv_v2_cell_volt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3.32V"
            android:textColor="#EA80FC"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:id="@+id/divider_v2_3"
        android:layout_width="1dp"
        android:layout_height="11dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        android:background="#26FFFFFF" />

    <!-- 4. อัตราสิ้นเปลืองสด 50km (Consumption) -->
    <LinearLayout
        android:id="@+id/container_v2_consumption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📊"
            android:textSize="11sp"
            android:paddingEnd="2dp" />

        <TextView
            android:id="@+id/tv_v2_consumption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--.-"
            android:textColor="#FFD54F"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:id="@+id/divider_v2_inst_power"
        android:layout_width="1dp"
        android:layout_height="11dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        android:background="#26FFFFFF"
        android:visibility="gone" />

    <!-- 4B. กำลังไฟขณะขับขี่สด (Instant Power kW) -->
    <LinearLayout
        android:id="@+id/container_v2_inst_power"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚡สด"
            android:textColor="#FFD740"
            android:textSize="10sp"
            android:paddingEnd="2dp" />

        <TextView
            android:id="@+id/tv_v2_inst_power"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0.0 kW"
            android:textColor="#FFD740"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:id="@+id/divider_v2_4"
        android:layout_width="1dp"
        android:layout_height="11dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        android:background="#26FFFFFF" />

    <!-- 5. อุณหภูมิห้องโดยสาร (Cabin Temp) -->
    <LinearLayout
        android:id="@+id/container_v2_cabin_temp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="❄️"
            android:textSize="11sp"
            android:paddingEnd="2dp" />

        <TextView
            android:id="@+id/tv_v2_cabin_temp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="25°C"
            android:textColor="#80D8FF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:id="@+id/divider_v2_out_temp"
        android:layout_width="1dp"
        android:layout_height="11dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        android:background="#26FFFFFF"
        android:visibility="gone" />

    <!-- 5B. อุณหภูมิภายนอกรถ (Outside Temp) -->
    <LinearLayout
        android:id="@+id/container_v2_out_temp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🌤️"
            android:textSize="11sp"
            android:paddingEnd="2dp" />

        <TextView
            android:id="@+id/tv_v2_out_temp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="31°C"
            android:textColor="#FFE082"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:id="@+id/divider_v2_5"
        android:layout_width="1dp"
        android:layout_height="11dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        android:background="#26FFFFFF" />

    <!-- 6. สุขภาพแบตเตอรี่ (SOH) -->
    <LinearLayout
        android:id="@+id/container_v2_soh"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🛡️"
            android:textSize="11sp"
            android:paddingEnd="2dp" />

        <TextView
            android:id="@+id/tv_v2_soh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="100%"
            android:textColor="#B388FF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:id="@+id/divider_v2_6"
        android:layout_width="1dp"
        android:layout_height="11dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        android:background="#26FFFFFF" />

    <!-- 7. แบตเตอรี่ลูกเล็ก 12V Aux -->
    <LinearLayout
        android:id="@+id/container_v2_12v"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="12V:"
            android:textColor="#90A4AE"
            android:textSize="10sp"
            android:paddingEnd="2dp" />

        <TextView
            android:id="@+id/tv_v2_12v"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="13.8V"
            android:textColor="#69F0AE"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:id="@+id/divider_v2_tpms"
        android:layout_width="1dp"
        android:layout_height="11dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        android:background="#26FFFFFF"
        android:visibility="gone" />

    <!-- 7B. แรงดันลมยาง 4 ล้อ (TPMS) -->
    <LinearLayout
        android:id="@+id/container_v2_tpms"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🛞"
            android:textSize="11sp"
            android:paddingEnd="2dp" />

        <TextView
            android:id="@+id/tv_v2_tpms"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="250 kPa"
            android:textColor="#80CBC4"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:id="@+id/divider_v2_odo"
        android:layout_width="1dp"
        android:layout_height="11dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        android:background="#26FFFFFF"
        android:visibility="gone" />

    <!-- 7C. เลขไมล์รวม (Odometer) -->
    <LinearLayout
        android:id="@+id/container_v2_odo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🛣️"
            android:textSize="11sp"
            android:paddingEnd="2dp" />

        <TextView
            android:id="@+id/tv_v2_odo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-- km"
            android:textColor="#B0BEC5"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:id="@+id/divider_v2_7"
        android:layout_width="1dp"
        android:layout_height="11dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        android:background="#26FFFFFF" />

    <!-- 8. เกียร์และความเร็ว (Gear / Speed) -->
    <LinearLayout
        android:id="@+id/container_v2_gear_speed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_v2_gear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="P"
            android:textColor="#FFAB40"
            android:textSize="13sp"
            android:textStyle="bold"
            android:paddingEnd="3dp" />

        <TextView
            android:id="@+id/tv_v2_speed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 km/h"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
