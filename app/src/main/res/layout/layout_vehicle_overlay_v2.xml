<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/v2_pill_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_kinex_dock_bar"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="10dp"
    android:paddingTop="4dp"
    android:paddingEnd="10dp"
    android:paddingBottom="4dp"
    android:elevation="8dp">

    <!-- จุดจับลาก (Drag Handle) -->
    <TextView
        android:id="@+id/tv_drag_handle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⋮⋮"
        android:textColor="#546E7A"
        android:textSize="11sp"
        android:paddingEnd="6dp" />

    <!-- Left Section in Stock Bar Mode: System Status Indicators (OEM 1:1) -->
    <LinearLayout
        android:id="@+id/container_system_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- 1. DASHCAM / DVR REC -->
        <LinearLayout
            android:id="@+id/container_status_camera"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginEnd="12dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_status_camera"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📷 DVR"
                android:textColor="#90A4AE"
                android:textSize="13.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 2. GPS -->
        <LinearLayout
            android:id="@+id/container_status_gps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginEnd="12dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_status_gps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📍 GPS"
                android:textColor="#40C4FF"
                android:textSize="13.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 3. Bluetooth -->
        <LinearLayout
            android:id="@+id/container_status_bt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginEnd="12dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_status_bt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BT"
                android:textColor="#80D8FF"
                android:textSize="13.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 4. Wi-Fi -->
        <LinearLayout
            android:id="@+id/container_status_wifi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginEnd="12dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_status_wifi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Wi-Fi"
                android:textColor="#ECEFF1"
                android:textSize="13.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 5. 4G / SIM -->
        <LinearLayout
            android:id="@+id/container_status_sim"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginEnd="6dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_status_sim"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4G"
                android:textColor="#ECEFF1"
                android:textSize="13.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Left spacer: pushes telemetry to center in Stock Bar Mode -->
    <View
        android:id="@+id/spacer_stock_left"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1"
        android:visibility="gone" />

    <!-- 1. ระดับแบตเตอรี่ปัจจุบัน (Current SoC) -->
    <LinearLayout
        android:id="@+id/container_v2_soc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SOC"
            android:textColor="#90A4AE"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:paddingEnd="3dp" />

        <TextView
            android:id="@+id/tv_v2_soc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--%"
            android:textColor="#69F0AE"
            android:textSize="11.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:id="@+id/divider_v2_1"
        android:layout_width="1dp"
        android:layout_height="11dp"
        android:layout_marginStart="3dp"
        android:layout_marginEnd="3dp"
        android:background="#26FFFFFF" />

    <!-- 2. พลังงานแบตเตอรี่คงเหลือจริง (Remaining kWh จาก BMS) -->
    <LinearLayout
        android:id="@+id/container_v2_kwh"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_v2_kwh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-- kWh"
            android:textColor="#00E676"
            android:textSize="11.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:id="@+id/divider_v2_2"
        android:layout_width="1dp"
        android:layout_height="11dp"
        android:layout_marginStart="3dp"
        android:layout_marginEnd="3dp"
        android:background="#26FFFFFF" />

    <!-- 3. ระยะทางวิ่งได้จริง (Real Range) -->
    <LinearLayout
        android:id="@+id/container_v2_real_range"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RANGE"
            android:textColor="#90A4AE"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:paddingEnd="3dp" />

        <TextView
            android:id="@+id/tv_v2_real_range"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-- km"
            android:textColor="#40C4FF"
            android:textSize="11.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:id="@+id/divider_v2_dash_range"
        android:layout_width="1dp"
        android:layout_height="11dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:background="#20FFFFFF"
        android:visibility="gone" />

    <!-- 3B. ระยะทางบนหน้าปัดรถ (Dashboard Range) -->
    <LinearLayout
        android:id="@+id/container_v2_dash_range"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DASH"
            android:textColor="#90A4AE"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:paddingEnd="3dp" />

        <TextView
            android:id="@+id/tv_v2_dash_range"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-- km"
            android:textColor="#ECEFF1"
            android:textSize="11.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Group 2: แบตเตอรี่ลูกใหญ่และประสิทธิภาพ (HV Battery & Performance) -->
    <View
        android:id="@+id/divider_v2_hv_temp"
        android:layout_width="1dp"
        android:layout_height="12dp"
        android:layout_marginStart="5dp"
        android:layout_marginEnd="5dp"
        android:background="#33FFFFFF" />

    <!-- 4. อุณหภูมิแบตเตอรี่ลูกใหญ่ (HV Main Battery Temp) -->
    <LinearLayout
        android:id="@+id/container_v2_hv_temp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BATT"
            android:textColor="#90A4AE"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:paddingEnd="3dp" />

        <TextView
            android:id="@+id/tv_v2_hv_temp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="29°C"
            android:textColor="#FFAB40"
            android:textSize="11.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:id="@+id/divider_v2_soh"
        android:layout_width="1dp"
        android:layout_height="11dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:background="#20FFFFFF" />

    <!-- 5. สุขภาพแบตเตอรี่ (SOH) -->
    <LinearLayout
        android:id="@+id/container_v2_soh"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SOH"
            android:textColor="#90A4AE"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:paddingEnd="3dp" />

        <TextView
            android:id="@+id/tv_v2_soh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="100%"
            android:textColor="#ECEFF1"
            android:textSize="11.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:id="@+id/divider_v2_consumption"
        android:layout_width="1dp"
        android:layout_height="11dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:background="#20FFFFFF" />

    <!-- 6. อัตราสิ้นเปลืองสด 50km (Consumption) -->
    <LinearLayout
        android:id="@+id/container_v2_consumption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AVG"
            android:textColor="#90A4AE"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:paddingEnd="3dp" />

        <TextView
            android:id="@+id/tv_v2_consumption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--.-"
            android:textColor="#ECEFF1"
            android:textSize="11.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:id="@+id/divider_v2_cell_volt"
        android:layout_width="1dp"
        android:layout_height="11dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:background="#20FFFFFF"
        android:visibility="gone" />

    <!-- 6B. แรงดันเซลล์แบตใหญ่ (HV Cell Voltage) -->
    <LinearLayout
        android:id="@+id/container_v2_cell_volt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CELL"
            android:textColor="#90A4AE"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:paddingEnd="3dp" />

        <TextView
            android:id="@+id/tv_v2_cell_volt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3.32V"
            android:textColor="#ECEFF1"
            android:textSize="11.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:id="@+id/divider_v2_inst_power"
        android:layout_width="1dp"
        android:layout_height="11dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:background="#20FFFFFF"
        android:visibility="gone" />

    <!-- 6C. กำลังไฟขณะขับขี่สด (Instant Power kW) -->
    <LinearLayout
        android:id="@+id/container_v2_inst_power"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PWR"
            android:textColor="#90A4AE"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:paddingEnd="3dp" />

        <TextView
            android:id="@+id/tv_v2_inst_power"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0.0 kW"
            android:textColor="#ECEFF1"
            android:textSize="11.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Group 3: ล้อ แบต 12V และสภาพอากาศ (Chassis, 12V & Ambient) -->
    <View
        android:id="@+id/divider_v2_tpms"
        android:layout_width="1dp"
        android:layout_height="12dp"
        android:layout_marginStart="5dp"
        android:layout_marginEnd="5dp"
        android:background="#33FFFFFF"
        android:visibility="gone" />

    <!-- 7. แรงดันลมยาง 4 ล้อ (TPMS) -->
    <LinearLayout
        android:id="@+id/container_v2_tpms"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TPMS"
            android:textColor="#90A4AE"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:paddingEnd="3dp" />

        <TextView
            android:id="@+id/tv_v2_tpms"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:singleLine="true"
            android:text="250 kPa"
            android:textColor="#80CBC4"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:id="@+id/divider_v2_12v"
        android:layout_width="1dp"
        android:layout_height="11dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:background="#20FFFFFF" />

    <!-- 8. แบตเตอรี่ลูกเล็ก 12V Aux -->
    <LinearLayout
        android:id="@+id/container_v2_12v"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="12V"
            android:textColor="#90A4AE"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:paddingEnd="3dp" />

        <TextView
            android:id="@+id/tv_v2_12v"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="13.8V"
            android:textColor="#ECEFF1"
            android:textSize="11.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:id="@+id/divider_v2_out_temp"
        android:layout_width="1dp"
        android:layout_height="11dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:background="#20FFFFFF" />

    <!-- 9. อุณหภูมิภายนอกรถ (Outside Temp) -->
    <LinearLayout
        android:id="@+id/container_v2_out_temp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OUT"
            android:textColor="#90A4AE"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:paddingEnd="3dp" />

        <TextView
            android:id="@+id/tv_v2_out_temp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="31°C"
            android:textColor="#ECEFF1"
            android:textSize="11.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:id="@+id/divider_v2_odo"
        android:layout_width="1dp"
        android:layout_height="11dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:background="#20FFFFFF"
        android:visibility="gone" />

    <!-- 10. เลขไมล์สะสม (Odometer) -->
    <LinearLayout
        android:id="@+id/container_v2_odo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ODO"
            android:textColor="#90A4AE"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:paddingEnd="3dp" />

        <TextView
            android:id="@+id/tv_v2_odo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-- km"
            android:textColor="#ECEFF1"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:id="@+id/divider_v2_7"
        android:layout_width="1dp"
        android:layout_height="11dp"
        android:layout_marginStart="3dp"
        android:layout_marginEnd="3dp"
        android:background="#26FFFFFF" />

    <!-- 8. เกียร์และความเร็ว (Gear / Speed) -->
    <LinearLayout
        android:id="@+id/container_v2_gear_speed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_v2_gear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="P"
            android:textColor="#FFAB40"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:paddingEnd="3dp" />

        <TextView
            android:id="@+id/tv_v2_speed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 km/h"
            android:textColor="#FFFFFF"
            android:textSize="11.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Right spacer: pushes system status indicators to right in Stock Bar Mode -->
    <View
        android:id="@+id/spacer_stock_right"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1"
        android:visibility="gone" />

    <!-- Right Section in Stock Bar Mode: Clock & Date (OEM 1:1) -->
    <LinearLayout
        android:id="@+id/container_stock_clock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextClock
            android:id="@+id/tc_stock_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="HH:mm"
            android:format24Hour="HH:mm"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextClock
            android:id="@+id/tc_stock_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:format12Hour="E, d MMM"
            android:format24Hour="E, d MMM"
            android:textColor="#90A4AE"
            android:textSize="12sp" />
    </LinearLayout>

</LinearLayout>
