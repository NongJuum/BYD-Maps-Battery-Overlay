<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0D14">

    <!-- Top App Bar -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#121721"
        app:elevation="2dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="🚗 BYD Vehicle Data Overlay 2.0"
            app:titleTextColor="#FFFFFF"
            app:subtitle="BYD Telemetry &amp; Independent HUD"
            app:subtitleTextColor="#80D8FF" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="40dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 1. MASTER TOGGLE BANNER CARD -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_master_toggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="18dp"
                app:cardElevation="4dp"
                app:strokeWidth="1dp"
                app:strokeColor="#253244"
                app:cardBackgroundColor="#161C26">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="18dp">

                    <ImageView
                        android:id="@+id/iv_overlay_status_dot"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginEnd="12dp"
                        android:src="@drawable/ic_status_dot_active" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Floating Overlay Service"
                            android:textColor="#FFFFFF"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_master_status_desc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="สถานะ: กำลังแสดงผลบนหน้าจอ (Active)"
                            android:textColor="#81C784"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switch_overlay_master"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textOn=""
                        android:textOff=""
                        android:showText="false"
                        android:checked="true" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 2. TELEMETRY PREVIEW CARD (CAN BUS LIVE FEED) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:strokeWidth="1dp"
                app:strokeColor="#1F2A38"
                app:cardBackgroundColor="#131924">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="⚡ Live Vehicle Telemetry"
                            android:textColor="#40C4FF"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_vehicle_model_badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="#1E2B3C"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp"
                            android:text="BYD Dolphin (Live)"
                            android:textColor="#80D8FF"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Telemetry Metrics Grid -->
                    <GridLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:columnCount="3"
                        android:rowCount="2">

                        <!-- SoC % -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:layout_margin="3dp"
                            android:background="#1B2332"
                            android:padding="10dp"
                            android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Battery SoC" android:textColor="#90A4AE" android:textSize="11sp"/>
                            <TextView android:id="@+id/tv_dash_soc" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-- %" android:textColor="#00E676" android:textSize="18sp" android:textStyle="bold"/>
                        </LinearLayout>

                        <!-- Remain kWh -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:layout_margin="3dp"
                            android:background="#1B2332"
                            android:padding="10dp"
                            android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Remain kWh" android:textColor="#90A4AE" android:textSize="11sp"/>
                            <TextView android:id="@+id/tv_dash_kwh" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-- kWh" android:textColor="#00E5FF" android:textSize="18sp" android:textStyle="bold"/>
                        </LinearLayout>

                        <!-- Real Range -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:layout_margin="3dp"
                            android:background="#1B2332"
                            android:padding="10dp"
                            android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Real Range" android:textColor="#90A4AE" android:textSize="11sp"/>
                            <TextView android:id="@+id/tv_dash_real_range" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-- km" android:textColor="#FFD54F" android:textSize="18sp" android:textStyle="bold"/>
                        </LinearLayout>

                        <!-- Consumption 50km -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:layout_margin="3dp"
                            android:background="#1B2332"
                            android:padding="10dp"
                            android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Avg 50km" android:textColor="#90A4AE" android:textSize="11sp"/>
                            <TextView android:id="@+id/tv_dash_consumption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-- kWh" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold"/>
                        </LinearLayout>

                        <!-- Cabin Temp -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:layout_margin="3dp"
                            android:background="#1B2332"
                            android:padding="10dp"
                            android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Cabin Temp" android:textColor="#90A4AE" android:textSize="11sp"/>
                            <TextView android:id="@+id/tv_dash_cabin_temp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="25°C" android:textColor="#80D8FF" android:textSize="16sp" android:textStyle="bold"/>
                        </LinearLayout>

                        <!-- 12V Battery -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:layout_margin="3dp"
                            android:background="#1B2332"
                            android:padding="10dp"
                            android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="12V Aux" android:textColor="#90A4AE" android:textSize="11sp"/>
                            <TextView android:id="@+id/tv_dash_12v" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="13.8 V" android:textColor="#69F0AE" android:textSize="16sp" android:textStyle="bold"/>
                        </LinearLayout>
                    </GridLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 3. PILL CAPSULE DISPLAY DATA CUSTOMIZATION -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="8dp"
                android:text="เลือกข้อมูลที่จะแสดงบน FLOATING PILL"
                android:textColor="#78909C"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <!-- หมวด 1: แบตเตอรี่และระยะทาง -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:cardCornerRadius="14dp"
                app:strokeWidth="1dp"
                app:strokeColor="#1E2633"
                app:cardBackgroundColor="#141A24">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔋 หมวด แบตเตอรี่และระยะทาง"
                        android:textColor="#00E676"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:textOn=""
                        android:textOff=""
                        android:showText="false"
                        android:id="@+id/switch_show_soc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="ระดับแบตเตอรี่ (SoC %)"
                        android:textColor="#ECEFF1"
                        android:checked="true" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:textOn=""
                        android:textOff=""
                        android:showText="false"
                        android:id="@+id/switch_show_remain_kwh"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="ความจุคงเหลือจริงจาก BMS (Remain kWh)"
                        android:textColor="#ECEFF1"
                        android:checked="true" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:textOn=""
                        android:textOff=""
                        android:showText="false"
                        android:id="@+id/switch_show_real_range"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="ระยะทางประเมินจริง (Real Range km)"
                        android:textColor="#ECEFF1"
                        android:checked="true" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:textOn=""
                        android:textOff=""
                        android:showText="false"
                        android:id="@+id/switch_show_soh"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="สุขภาพแบตเตอรี่ (SOH %)"
                        android:textColor="#ECEFF1" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:textOn=""
                        android:textOff=""
                        android:showText="false"
                        android:id="@+id/switch_show_12v"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="แรงดันไฟแบตเตอรี่ลูกเล็ก (12V Aux)"
                        android:textColor="#ECEFF1" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- หมวด 2: การขับขี่ & อุณหภูมิห้องโดยสาร -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardCornerRadius="14dp"
                app:strokeWidth="1dp"
                app:strokeColor="#1E2633"
                app:cardBackgroundColor="#141A24">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🚗 หมวด การขับขี่ &amp; ห้องโดยสาร"
                        android:textColor="#40C4FF"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:textOn=""
                        android:textOff=""
                        android:showText="false"
                        android:id="@+id/switch_show_cabin_temp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="❄️ อุณหภูมิในห้องโดยสาร (Cabin Temp °C)"
                        android:textColor="#ECEFF1"
                        android:checked="true" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:textOn=""
                        android:textOff=""
                        android:showText="false"
                        android:id="@+id/switch_show_consume_50km"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="อัตรากินไฟ 50 km ล่าสุด (kWh/100km)"
                        android:textColor="#ECEFF1"
                        android:checked="true" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:textOn=""
                        android:textOff=""
                        android:showText="false"
                        android:id="@+id/switch_show_speed"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="ความเร็วรถดิจิทัล (Digital Speed)"
                        android:textColor="#ECEFF1" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:textOn=""
                        android:textOff=""
                        android:showText="false"
                        android:id="@+id/switch_show_gear"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="ตำแหน่งเกียร์ปัจจุบัน (Gear P/R/N/D)"
                        android:textColor="#ECEFF1" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- หมวด 3: ความโปร่งใส & การประหยัดพลังงาน (Transparency & Low Resource) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardCornerRadius="14dp"
                app:strokeWidth="1dp"
                app:strokeColor="#1E2633"
                app:cardBackgroundColor="#141A24">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎛️ ความโปร่งใสของแถบ (Transparency / Opacity)"
                        android:textColor="#80D8FF"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="8dp">

                        <SeekBar
                            android:id="@+id/seek_overlay_opacity"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:max="100"
                            android:progress="85" />

                        <TextView
                            android:id="@+id/tv_opacity_value"
                            android:layout_width="48dp"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:text="85%"
                            android:textColor="#69F0AE"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- ปรับขนาด Overlay (Scale / Size) -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="🔍 ขนาดของแถบ Overlay (Scale Size 70% - 150%)"
                        android:textColor="#FFD54F"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="8dp">

                        <SeekBar
                            android:id="@+id/seek_overlay_scale"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:max="150"
                            android:progress="100" />

                        <TextView
                            android:id="@+id/tv_scale_value"
                            android:layout_width="48dp"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:text="100%"
                            android:textColor="#FFD54F"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- สลับทิศทาง Layout แนวนอน / แนวตั้ง -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="14dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="📐 สไตล์การจัดเรียงแถบ (Layout Orientation)"
                            android:textColor="#B388FF"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <RadioGroup
                            android:id="@+id/rg_overlay_orientation"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <RadioButton
                                android:id="@+id/rb_orientation_horizontal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="แนวนอน"
                                android:textColor="#ECEFF1"
                                android:checked="true" />

                            <RadioButton
                                android:id="@+id/rb_orientation_vertical"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="แนวตั้ง"
                                android:textColor="#ECEFF1" />
                        </RadioGroup>
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="⚡ โหมด Low RAM &amp; Ultra-low CPU: ปรับรอบ Polling อัตโนมัติ (หยุดประมวลผลเมื่อรถจอดนิ่ง/ไม่มีการเปลี่ยนแปลง)"
                        android:textColor="#90A4AE"
                        android:textSize="11sp" />

                    <!-- BSD Safety Chime Switch -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🔊 เสียงเตือนจุดอับสายตา (BSD Safety Chime)"
                                android:textColor="#ECEFF1"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="ส่งเสียงเตือนเฉพาะจังหวะมีรถในจุดอับและเปิดไฟเลี้ยว (ไฟกระจกกระพริบ)"
                                android:textColor="#78909C"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switch_bsd_sound"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true" />
                    </LinearLayout>

                    <!-- Test Chime Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_test_bsd_sound"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="10dp"
                        android:text="🔔 กดจำลองเสียงเตือน BSD (Test Chime บนลำโพงรถ)"
                        android:textSize="12sp"
                        app:cornerRadius="10dp"
                        app:backgroundTint="#37474F" />

                    <!-- Sound Tone Selector RadioGroup -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="🎵 เลือกสไตล์เสียงเตือน 10 แบบ (ต่ำ / กลาง / สูง):"
                        android:textColor="#B0BEC5"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <RadioGroup
                        android:id="@+id/rg_bsd_tone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="vertical">

                        <!-- โทนต่ำธรรมชาติ / พรีเมียม -->
                        <RadioButton
                            android:id="@+id/rb_tone_1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🟢 1. Kalimba Warm Wood (380Hz เคาะไม้คาลิมบา อบอุ่น นุ่มนวล)"
                            android:textColor="#81C784"
                            android:textSize="12sp" />

                        <RadioButton
                            android:id="@+id/rb_tone_2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🟢 2. Luxury Deep Thud (240Hz ทุ้มลึก หนักแน่น สไตล์รถยุโรปหรู)"
                            android:textColor="#81C784"
                            android:textSize="12sp" />

                        <RadioButton
                            android:id="@+id/rb_tone_3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🟢 3. Soft Marimba (520Hz มาริมบากลมมน ไม่แสบแก้วหู)"
                            android:textColor="#81C784"
                            android:textSize="12sp" />

                        <!-- โทน High-Tech ยอดฮิต -->
                        <RadioButton
                            android:id="@+id/rb_tone_4"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="✨ 4. High-Tech Glass Bell (Tesla ระฆังแก้วไซไฟ กังวานหรูหรา)"
                            android:textColor="#38BDF8"
                            android:textSize="12sp"
                            android:checked="true" />

                        <RadioButton
                            android:id="@+id/rb_tone_5"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="✨ 5. Cyber Pulse Ping (880Hz ยานอวกาศล้ำยุค คมชัด)"
                            android:textColor="#38BDF8"
                            android:textSize="12sp" />

                        <!-- โทนกลางคลาสสิก / สปอร์ต -->
                        <RadioButton
                            android:id="@+id/rb_tone_6"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🟡 6. Mercedes Harmony Chord (คอร์ดเมเจอร์หรูหรา 3 โน้ต)"
                            android:textColor="#FFD54F"
                            android:textSize="12sp" />

                        <RadioButton
                            android:id="@+id/rb_tone_7"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🟡 7. Porsche Sport Chime (850Hz ระฆังสปอร์ต ฉับไว ปลุกสมาธิ)"
                            android:textColor="#FFD54F"
                            android:textSize="12sp" />

                        <!-- โทน EV / เรดาร์ / Cockpit -->
                        <RadioButton
                            android:id="@+id/rb_tone_8"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="💎 8. EV Future Sweep (Sci-Fi กวาดความถี่ล้ำยุค ชวนมองกระจก)"
                            android:textColor="#38BDF8"
                            android:textSize="12sp" />

                        <RadioButton
                            android:id="@+id/rb_tone_9"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🟡 9. Crystal Sonar Radar (1.3kHz โซนาร์แก้วใส คมชัด)"
                            android:textColor="#FFD54F"
                            android:textSize="12sp" />

                        <RadioButton
                            android:id="@+id/rb_tone_10"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🔴 10. Euro ADAS Cockpit (1.6k+2.1k ฮาร์โมนิกคู่ ชัดแม้เปิดเพลงดัง)"
                            android:textColor="#FF8A80"
                            android:textSize="12sp" />
                    </RadioGroup>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 4. ACTION CONTROLS & RESET BUTTON -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_reset_pos"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_weight="1"
                    android:text="🎯 คืนค่าตำแหน่ง Overlay (Reset)"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:cornerRadius="12dp"
                    app:backgroundTint="#0277BD" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_save_config"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:text="💾 บันทึกการตั้งค่า"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:cornerRadius="12dp"
                    app:backgroundTint="#00C853" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
