<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_pill_modern"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="☕ ร่วมสนับสนุนผู้พัฒนา (Donate)"
            android:textColor="#FFD54F"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Developed by Nontarat Hasitapong"
            android:textColor="#40C4FF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="หากแอปนี้ช่วยให้คุณเดินทางได้สะดวกและมั่นใจขึ้น\nสามารถสนับสนุนค่าน้ำชา/กาแฟเป็นกำลังใจได้ครับ ❤️"
            android:textColor="#CFD8DC"
            android:textSize="12sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="12dp"
            android:background="#26FFFFFF" />

        <!-- 1. ช่องทาง PromptPay Thai QR Payment -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#151A24"
            android:orientation="vertical"
            android:padding="12dp"
            android:gravity="center_horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📱 สแกนผ่านแอปธนาคาร (PromptPay QR)"
                android:textColor="#69F0AE"
                android:textSize="13sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/iv_promptpay_qr"
                android:layout_width="220dp"
                android:layout_height="320dp"
                android:layout_marginTop="8dp"
                android:scaleType="fitCenter"
                android:background="#FFFFFF"
                android:padding="4dp"
                android:src="@drawable/qr_promptpay" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="ชื่อบัญชี: นาย นนทรัฐ หะสิตะพงษ์\n(MR NONTARAT HASITAPONG)"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 2. ช่องทาง Skrill (International / ต่างประเทศ) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#151A24"
            android:orientation="vertical"
            android:padding="12dp"
            android:gravity="center_horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌐 Skrill (International Support)"
                android:textColor="#E040FB"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_skrill_email"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="canon.non.7@gmail.com"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_copy_skrill"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:backgroundTint="#7B1FA2"
                    android:text="คัดลอก"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/btn_close_dialog"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginTop="14dp"
            android:backgroundTint="#37474F"
            android:text="ปิดหน้าต่าง"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
