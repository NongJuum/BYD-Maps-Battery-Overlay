<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base frosted translucent glass body -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#B81A283B"
                android:centerColor="#A6121C2A"
                android:endColor="#BF0B121C"
                android:type="linear" />
            <corners android:radius="20dp" />
            <stroke
                android:width="1.2dp"
                android:color="#73FFFFFF" />
        </shape>
    </item>

    <!-- Subtle top specular highlight sheen -->
    <item
        android:top="1dp"
        android:left="2dp"
        android:right="2dp"
        android:bottom="16dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#2CFFFFFF"
                android:endColor="#00FFFFFF"
                android:type="linear" />
            <corners
                android:topLeftRadius="19dp"
                android:topRightRadius="19dp"
                android:bottomLeftRadius="6dp"
                android:bottomRightRadius="6dp" />
        </shape>
    </item>
</layer-list>
